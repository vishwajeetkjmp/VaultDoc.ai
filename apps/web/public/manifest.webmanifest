{
  "id": "/dashboard",
  "name": "VaultDocAI",
  "short_name": "VaultDoc",
  "description": "Your private document space with AI. Ask questions about your documents and never miss a deadline.",
  "start_url": "/dashboard?source=app",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0a1628",
  "theme_color": "#0a1628",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "My Space", "url": "/dashboard?source=app", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Reminders", "url": "/dashboard?view=reminders&source=app", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Secure Vault", "url": "/vault?source=app", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
