# Private Gotenberg (LibreOffice) service on Cloud Run, Delhi. Only the functions'
# service account can call it (--no-allow-unauthenticated + roles/run.invoker).
GOTENBERG_URL=https://gotenberg-641269358237.asia-south2.run.app

# Links inside share emails (the public website)
APP_URL=https://vaultdocai.com

# The one Google account email that may claim the first admin Owner role (set before deploying)
OWNER_EMAIL=
# Sender of share invites (vaultdocai.com is verified in Resend)
MAIL_FROM=VaultDocAI <share@vaultdocai.com>

# Where Claude runs: "vertex" (Google Cloud bill, no key) or "anthropic" (needs the ANTHROPIC_API_KEY secret)
AI_PROVIDER=vertex
AI_VERTEX_REGION=global
