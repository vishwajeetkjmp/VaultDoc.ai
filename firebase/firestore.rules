rules_version = '2';

// Data layout
//   config/limits                   { maxFileBytes, quotaBytes }        — edited by admins in the console
//   users/{uid}                     { usedBytes, fileCount, quotaBytes? } — usage is written only by Cloud Functions
//   users/{uid}/items/{itemId}      a file or folder in the user's tree
//   users/{uid}/vault/meta          Secure Vault: vault key wrapped by the recovery key
//   users/{uid}/vaultItems/{itemId} Secure Vault: encrypted file/folder record
//   shares/{linkId}                 a shared My Space item; written only by Cloud Functions
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Google accounts arrive verified; email/password accounts must click their verification link
    function verified() {
      return request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid && verified();
    }

    // Owners see their own shares ("Shared by me"); recipients go through Cloud Functions
    match /shares/{linkId} {
      allow read: if signedIn() && verified() && resource.data.ownerUid == request.auth.uid;
      allow write: if false;
    }

    match /config/{doc} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      // The app creates an empty usage record on first visit; only Cloud Functions change it afterwards
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['usedBytes', 'fileCount', 'createdAt'])
        && request.resource.data.usedBytes == 0
        && request.resource.data.fileCount == 0;
      allow update, delete: if false;

      // Internal bookkeeping for Cloud Functions
      match /_events/{eventId} {
        allow read, write: if false;
      }

      match /items/{itemId} {
        function validName(name) {
          return name is string && name.size() > 0 && name.size() <= 255 && !name.matches('.*[/\\\\].*');
        }

        function validPlacement(data) {
          return data.parentId is string
            && data.ancestorIds is list
            && data.ancestorIds.size() <= 32;
        }

        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && validName(request.resource.data.name)
          && request.resource.data.nameLower == request.resource.data.name.lower()
          && validPlacement(request.resource.data)
          && (
            // Folders are ready straight away
            (request.resource.data.kind == 'folder'
              && request.resource.data.status == 'ready')
            ||
            // Files start as 'uploading'; a Cloud Function marks them 'ready' with the real size
            (request.resource.data.kind == 'file'
              && request.resource.data.status == 'uploading'
              && request.resource.data.size is int
              && request.resource.data.storagePath == 'users/' + uid + '/files/' + itemId)
          );

        // Rename only. Kind, size, status and storage location can't be changed by the app.
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'nameLower', 'updatedAt'])
          && validName(request.resource.data.name)
          && request.resource.data.nameLower == request.resource.data.name.lower();

        // Deleting a file record also deletes the stored file (Cloud Function)
        allow delete: if isOwner(uid);
      }

      // ---------- Secure Vault (end-to-end encrypted; the server only sees ciphertext) ----------

      // The vault key, wrapped by the user's recovery key. Created once; deleted only to erase the vault.
      match /vault/{docId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && docId == 'meta'
          && request.resource.data.keys().hasOnly(['version', 'salt', 'wrappedVaultKey', 'createdAt'])
          && request.resource.data.wrappedVaultKey is string
          && request.resource.data.salt is string;
        allow update: if false;
        allow delete: if isOwner(uid);
      }

      match /vaultItems/{itemId} {
        function encryptedField(v) {
          return v is string && v.size() > 0 && v.size() < 8192;
        }

        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && encryptedField(request.resource.data.encMeta)
          && request.resource.data.parentId is string
          && request.resource.data.ancestorIds is list
          && request.resource.data.ancestorIds.size() <= 32
          && (
            (request.resource.data.kind == 'folder' && request.resource.data.status == 'ready')
            ||
            (request.resource.data.kind == 'file'
              && request.resource.data.status == 'uploading'
              && request.resource.data.size is int
              && encryptedField(request.resource.data.wrappedKey)
              && request.resource.data.storagePath == 'users/' + uid + '/vault/' + itemId)
          );

        // Rename only (re-encrypted name)
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['encMeta', 'updatedAt'])
          && encryptedField(request.resource.data.encMeta);

        allow delete: if isOwner(uid);
      }
    }
  }
}
