rules_version = '2';

// Files live at users/{uid}/files/{itemId}.
// These rules only check what they can decide on their own (owner, size cap,
// file type). The per-user quota and any lower limits from config/limits are
// enforced by the onFileUploaded Cloud Function, which deletes uploads that
// break them. Keep MAX_FILE_BYTES and the allowed types in sync with
// apps/web/lib/files/limits.ts and fileTypes.ts.
service firebase.storage {
  match /b/{bucket}/o {

    // Hard ceiling per file: 20 MB, or 50 MB on Pro (the `plan` login claim, set only by
    // Cloud Functions). config/limits can only lower the Free limit.
    function maxFileBytes() {
      return request.auth != null && request.auth.token.get('plan', '') == 'pro'
        ? 50 * 1024 * 1024
        : 20 * 1024 * 1024;
    }

    // Signed in as this user, with a verified email (Google accounts arrive verified)
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true;
    }

    function allowedType(contentType) {
      return contentType.matches(
        'application/pdf'
        + '|application/msword'
        + '|application/vnd\\.openxmlformats-officedocument\\.(wordprocessingml\\.document|spreadsheetml\\.sheet|presentationml\\.presentation)'
        + '|application/vnd\\.ms-excel'
        + '|application/vnd\\.ms-powerpoint'
        + '|application/rtf'
        + '|application/json'
        + '|text/(plain|csv|markdown)'
        + '|image/(png|jpeg|webp|gif)'
      );
    }

    match /users/{uid}/files/{itemId} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.size <= maxFileBytes()
        && allowedType(request.resource.contentType);

      // Files are never overwritten in place; deletes go through Firestore + Cloud Functions
      allow update, delete: if false;
    }

    // Secure Vault: encrypted in the browser, so the server only ever sees opaque bytes.
    // A little headroom over the file limit for the encryption's IV and tag.
    match /users/{uid}/vault/{itemId} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.size <= maxFileBytes() + 1024
        && request.resource.contentType == 'application/octet-stream';

      allow update, delete: if false;
    }
  }
}
